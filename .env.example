# Postgres-verbinding (Neon via Vercel Storage vult deze automatisch in)
DATABASE_URL=postgres://gebruiker:wachtwoord@host/db?sslmode=require
# Willekeurige geheime sleutel van minimaal 32 tekens (npm run hash-password genereert er één)
SESSION_SECRET=
# Beheerder-login
ADMIN_EMAIL=
# Uitvoer van: npm run hash-password  (begint met b64:)
ADMIN_PASSWORD_HASH=
